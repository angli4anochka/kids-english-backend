{
  "name": "kids-english-backend",
  "version": "1.0.0",
  "description": "Backend for Kids English Learning App",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:simple": "ts-node-dev --respawn --transpile-only src/server-simple.ts",
    "build": "tsc",
    "build:simple": "tsc src/server-simple.ts --outDir dist --module commonjs --target es2020 --esModuleInterop --resolveJsonModule --skipLibCheck",
    "start": "node dist/server.js",
    "start:simple": "node dist/server-simple.js",
    "migrate": "node dist/scripts/migrate.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "deploy": "npm run build:simple && tar -czf backend-deploy.tar.gz dist/server-simple.js package.json schema.sql .env.production.example"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.2.1",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "pg": "^8.11.0",
    "redis": "^4.6.5",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^30.4.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
